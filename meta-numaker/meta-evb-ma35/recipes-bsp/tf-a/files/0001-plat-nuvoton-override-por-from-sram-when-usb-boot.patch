+++ b/plat/nuvoton/ma35h0/ma35h0_io_storage.c
@@ -308,6 +308,10 @@ void ma35h0_io_setup(void)
 		por = mmio_read_32(SYS_PWRONPIN);
 		por = por << 8;
 	}
+	if ((por & PWRON_BOOT_MSK) == PWRON_BOOT_USB) {
+		printf("Boot from USB, will read SRAM-tail\n");
+		por = mmio_read_32(0x2803FFFC);
+	}
 	printf("POR: 0x%x\n", por);
 
