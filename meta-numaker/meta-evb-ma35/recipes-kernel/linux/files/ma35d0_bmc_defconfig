# MA35D0 OpenBMC minimal kernel configuration
# Stripped for BMC use - no WiFi, Audio, Display, Camera, USB host, CAN, NFS

# ---- General ----
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="ma35d0-bmc"
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NO_HZ=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_LOG_BUF_SHIFT=16
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_EXPERT=y

# ---- Cgroups (required by systemd) ----
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y

# ---- Namespaces (required by systemd) ----
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# ---- Initrd ----
CONFIG_BLK_DEV_INITRD=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set

# ---- Architecture ----
CONFIG_ARCH_MA35D0=y
# CONFIG_ARM64_ERRATUM_826319 is not set
# CONFIG_ARM64_ERRATUM_827319 is not set
# CONFIG_ARM64_ERRATUM_824069 is not set
# CONFIG_ARM64_ERRATUM_819472 is not set
# CONFIG_ARM64_ERRATUM_832075 is not set
# CONFIG_ARM64_ERRATUM_845719 is not set
# CONFIG_ARM64_ERRATUM_843419 is not set
# CONFIG_ARM64_ERRATUM_1024718 is not set
# CONFIG_ARM64_ERRATUM_1463225 is not set
# CONFIG_CAVIUM_ERRATUM_22375 is not set
# CONFIG_CAVIUM_ERRATUM_23154 is not set
# CONFIG_CAVIUM_ERRATUM_27456 is not set
# CONFIG_CAVIUM_ERRATUM_30115 is not set
# CONFIG_HISILICON_ERRATUM_161600802 is not set
# CONFIG_QCOM_FALKOR_ERRATUM_1003 is not set
# CONFIG_QCOM_FALKOR_ERRATUM_1009 is not set
# CONFIG_QCOM_QDF2400_ERRATUM_0065 is not set
# CONFIG_QCOM_FALKOR_ERRATUM_E1041 is not set
# CONFIG_SOCIONEXT_SYNQUACER_PREITS is not set
# CONFIG_FSL_ERRATUM_A008585 is not set
# CONFIG_HISILICON_ERRATUM_161010101 is not set
# CONFIG_ARM64_ERRATUM_858921 is not set
CONFIG_ARM64_VA_BITS_48=y
CONFIG_NR_CPUS=2
# CONFIG_NUMA is not set
CONFIG_HZ_250=y
CONFIG_COMPAT=y
# CONFIG_ARM64_HW_AFDBM is not set
# CONFIG_ARM64_PAN is not set
# CONFIG_ARM64_SVE is not set

# ---- Power management ----
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
CONFIG_CPU_IDLE=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=y
CONFIG_CPUFREQ_DT=y

# ---- Modules ----
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# ---- Block / Partition ----
CONFIG_PARTITION_ADVANCED=y
# CONFIG_COMPAT_BRK is not set

# ---- Memory ----
CONFIG_DEFAULT_MMAP_MIN_ADDR=32768

# ---- Networking ----
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
# CONFIG_WIRELESS is not set

# ---- Device infrastructure ----
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FW_LOADER=y

# ---- MTD / Flash ----
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_RAW_NAND=y
CONFIG_MTD_NAND_NUVOTON_MA35=y
CONFIG_MTD_SPI_NAND=y
CONFIG_MTD_SPI_NOR=y
CONFIG_MTD_UBI=y
CONFIG_MTD_UBI_FASTMAP=y
CONFIG_MTD_UBI_BLOCK=y

# ---- Device Tree Overlay ----
CONFIG_OF_OVERLAY=y

# ---- RAM disk (for initramfs if needed) ----
CONFIG_BLK_DEV_RAM=y

# ---- Timer ----
CONFIG_MA35D0_TIMER=y

# ---- Network device ----
CONFIG_NETDEVICES=y
CONFIG_STMMAC_ETH=y
# CONFIG_DWMAC_GENERIC is not set
CONFIG_DWMAC_NUVOTON=y
CONFIG_REALTEK_PHY=y
# CONFIG_USB_NET_DRIVERS is not set

# ---- Input (minimal) ----
# CONFIG_INPUT_LEDS is not set
# CONFIG_KEYBOARD_ATKBD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_SERIO is not set

# ---- Serial / Console ----
# CONFIG_LEGACY_PTYS is not set
CONFIG_SERIAL_MA35D0=y
CONFIG_SERIAL_MA35D0_CONSOLE=y
CONFIG_SERIAL_DEV_BUS=y

# ---- Hardware RNG ----
CONFIG_HW_RANDOM=y

# ---- I2C ----
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_MA35D0=y

# ---- SPI ----
CONFIG_SPI=y
CONFIG_SPI_BITBANG=y
CONFIG_SPI_MEM=y
CONFIG_SPI_MA35D0_QSPI=y

# ---- GPIO ----
CONFIG_GPIOLIB=y
CONFIG_GPIO_SYSFS=y

# ---- Watchdog ----
CONFIG_WATCHDOG=y

# ---- Thermal ----
CONFIG_THERMAL=y
CONFIG_THERMAL_WRITABLE_TRIPS=y
CONFIG_THERMAL_GOV_USER_SPACE=y
CONFIG_MA35D0_THERMAL=y

# ---- Regulator ----
CONFIG_REGULATOR=y
CONFIG_REGULATOR_MA35D0=y
CONFIG_REGULATOR_GPIO=y

# ---- PWM (fan control) ----
CONFIG_PWM=y
CONFIG_PWM_MA35D0=y

# ---- IIO / ADC ----
CONFIG_IIO=y
CONFIG_MA35_ADC=y

# ---- DMA ----
CONFIG_DMADEVICES=y
CONFIG_MA35D0_DMA=y

# ---- RTC ----
CONFIG_RTC_CLASS=y
# CONFIG_RTC_HCTOSYS is not set
# CONFIG_RTC_SYSTOHC is not set
CONFIG_RTC_DRV_MA35D0=y

# ---- PHY ----
CONFIG_PHY_MA35_USB=y

# ---- Filesystems ----
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_JFFS2_FS=y
CONFIG_JFFS2_SUMMARY=y
CONFIG_UBIFS_FS=y
CONFIG_UBIFS_FS_ADVANCED_COMPR=y
# CONFIG_NETWORK_FILESYSTEMS is not set

# ---- Security / Crypto ----
CONFIG_CRYPTO_USER=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_GHASH_ARM64_CE=y
CONFIG_CRYPTO_SHA1_ARM64_CE=y
CONFIG_CRYPTO_SHA2_ARM64_CE=y
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y

# ---- Misc required by systemd ----
CONFIG_AUTOFS_FS=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_FHANDLE=y
CONFIG_DMIID=y
CONFIG_NET_SCHED=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_PROC_CHILDREN=y

# ---- Kernel compression ----
CONFIG_XZ_DEC=y

# ---- Debugging (minimal for production) ----
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=5
# CONFIG_DEBUG_FS is not set
# CONFIG_PROFILING is not set

# ---- Disable unneeded subsystems ----
