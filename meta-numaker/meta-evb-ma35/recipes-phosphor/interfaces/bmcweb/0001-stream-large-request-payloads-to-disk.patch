From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenBMC Authors <openbmc@lists.ozlabs.org>
Date: Fri, 16 Oct 2026 19:20:00 +08:00
Subject: [PATCH] Stream large request payloads directly to disk to prevent OOM

Stream non-multipart payloads larger than 10MB directly to a temporary file
on flash (/tmp/images) instead of buffering into heap RAM. Use an unlinked
temporary file on flash for MemoryFileDescriptor instead of memfd_create,
and immediately release request body memory with malloc_trim(0) after writing
to disk.

Upstream-Status: Pending
---
diff --git a/http/http_body.hpp b/http/http_body.hpp
index d970e202f6..a80e22f612 100644
--- a/http/http_body.hpp
+++ b/http/http_body.hpp
@@ -126,6 +126,24 @@ class HttpBody::value_type
         return emptyFile;
     }
 
+    boost::beast::file_posix& file()
+    {
+        if (auto* fileBody = std::get_if<FileBody>(&bodyData))
+        {
+            return fileBody->fileHandle.fileHandle;
+        }
+        static boost::beast::file_posix emptyFile;
+        return emptyFile;
+    }
+
+    void setFileSize(size_t size)
+    {
+        if (auto* fileBody = std::get_if<FileBody>(&bodyData))
+        {
+            fileBody->fileSize = size;
+        }
+    }
+
     std::string& str()
     {
         if (auto* s = std::get_if<std::string>(&bodyData))
@@ -428,6 +446,32 @@ class HttpBody::reader
                 return;
             }
 
+            // Stream large payloads (> 10MB) directly to a temporary file on flash
+            // to avoid RAM exhaustion on memory-constrained systems.
+            if (*contentLength > 10UL * 1024UL * 1024UL &&
+                !contentType.starts_with("multipart/form-data"))
+            {
+                std::error_code ecDir;
+                std::filesystem::create_directories("/tmp/images", ecDir);
+                char pathTemplate[] = "/tmp/images/upload-XXXXXX";
+                int fd = mkostemp(pathTemplate, O_CLOEXEC | O_RDWR);
+                if (fd >= 0)
+                {
+                    unlink(pathTemplate);
+                    value.setFd(fd, ec);
+                    if (ec)
+                    {
+                        close(fd);
+                    }
+                    else
+                    {
+                        BMCWEB_LOG_INFO(
+                            "Streaming large upload ({} bytes) directly to /tmp/images temp file",
+                            *contentLength);
+                    }
+                }
+            }
+
             if (!value.file().is_open())
             {
                 value.str().reserve(static_cast<size_t>(*contentLength));
@@ -457,6 +501,16 @@ class HttpBody::reader
                     return 0;
                 }
             }
+            else if (value.file().is_open())
+            {
+                value.file().write(ptr, b.size(), ec);
+                if (ec)
+                {
+                    BMCWEB_LOG_ERROR("Failed to write buffer to file: {}",
+                                     ec.message());
+                    return 0;
+                }
+            }
             else
             {
                 value.str().append(ptr, b.size());
@@ -468,6 +522,21 @@ class HttpBody::reader
 
     void finish(boost::beast::error_code& ec)
     {
+        if (value.file().is_open())
+        {
+            boost::system::error_code ec2;
+            uint64_t size = value.file().size(ec2);
+            if (!ec2 && size < std::numeric_limits<size_t>::max())
+            {
+                value.setFileSize(static_cast<size_t>(size));
+            }
+            value.file().seek(0, ec);
+            if (ec)
+            {
+                BMCWEB_LOG_ERROR("Failed to rewind file: {}", ec.message());
+                return;
+            }
+        }
         if (multipartParser)
         {
             ParserError state = multipartParser->finish();
