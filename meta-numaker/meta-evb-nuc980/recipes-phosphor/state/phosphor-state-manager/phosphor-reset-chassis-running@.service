# NUC980 has no host power control hardware, so we replace the legacy
# phosphor-reset-chassis-running service (which waits forever for the
# non-existent /org/openbmc/control/power0 D-Bus object) with a no-op.
[Unit]
Description=Check Chassis%i pgood (NUC980: no-op)
Conflicts=obmc-chassis-poweroff@%i.target

[Service]
RemainAfterExit=yes
Type=oneshot
ExecStart=/bin/true

[Install]
# Handled by bitbake recipe
