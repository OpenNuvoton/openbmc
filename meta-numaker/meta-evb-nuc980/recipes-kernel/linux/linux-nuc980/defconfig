# NUC980 OpenBMC defconfig
# Based on nuc980_defconfig with OpenBMC systemd/LED/GPIO requirements merged
# and unused peripherals (USB, CAN, sound, media, FMI NAND) disabled.

# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_SYSVIPC=y
# CONFIG_CROSS_MEMORY_ATTACH is not set
CONFIG_USELIB=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT=y
CONFIG_BSD_PROCESS_ACCT=y
CONFIG_BSD_PROCESS_ACCT_V3=y

# --- Namespaces & cgroups (required by systemd) ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_MEMCG=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

CONFIG_INITRAMFS_SOURCE="../rootfs"
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_BOOT_CONFIG=y
CONFIG_EXPERT=y
# CONFIG_ARCH_MULTIPLATFORM is not set
# CONFIG_ARCH_MULTI_V7 is not set
CONFIG_ARCH_NUC980=y
CONFIG_AEABI=y
# CONFIG_CPU_SW_DOMAIN_PAN is not set
# CONFIG_ARM_MODULE_PLTS is not set
CONFIG_ZBOOT_ROM_TEXT=0
CONFIG_ZBOOT_ROM_BSS=0
CONFIG_CMDLINE="root=/dev/ram0 console=ttyS0,115200n8 rdinit=/linuxrc mem=64M"
# CONFIG_SUSPEND is not set
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_IOSCHED_BFQ is not set
# CONFIG_CORE_DUMP_DEFAULT_ELF_HEADERS is not set
# CONFIG_SWAP is not set
# CONFIG_COMPAT_BRK is not set

# --- Networking ---
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_PACKET_DIAG=y
CONFIG_UNIX=y
CONFIG_UNIX_DIAG=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
# CONFIG_INET_DIAG is not set
# CONFIG_CAN is not set
# CONFIG_WIRELESS is not set

# --- Device model ---
CONFIG_UEVENT_HELPER=y
CONFIG_UEVENT_HELPER_PATH="/sbin/hotplug"
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# CONFIG_STANDALONE is not set
# CONFIG_PREVENT_FIRMWARE_BUILD is not set

# --- MTD / SPI NAND / UBI ---
# CONFIG_FMI_NUC980 is not set
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_PLATRAM=y
CONFIG_MTD_BLOCK2MTD=y
CONFIG_MTD_RAW_NAND=y
CONFIG_MTD_SPI_NAND=y
CONFIG_MTD_SPI_NOR=y
CONFIG_MTD_UBI=y

# --- Block devices ---
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_SIZE=32768

# --- SCSI (needed for some block devices) ---
CONFIG_SCSI=y
# CONFIG_SCSI_PROC_FS is not set
CONFIG_BLK_DEV_SD=y
# CONFIG_SCSI_LOWLEVEL is not set

# --- Networking drivers ---
CONFIG_NETDEVICES=y
CONFIG_DUMMY=y
# CONFIG_NET_VENDOR_ALACRITECH is not set
# CONFIG_NET_VENDOR_AMAZON is not set
# CONFIG_NET_VENDOR_AQUANTIA is not set
# CONFIG_NET_VENDOR_ARC is not set
# CONFIG_NET_VENDOR_BROADCOM is not set
# CONFIG_NET_VENDOR_CADENCE is not set
# CONFIG_NET_VENDOR_CAVIUM is not set
# CONFIG_NET_VENDOR_CIRRUS is not set
# CONFIG_NET_VENDOR_EZCHIP is not set
# CONFIG_NET_VENDOR_FARADAY is not set
# CONFIG_NET_VENDOR_GOOGLE is not set
# CONFIG_NET_VENDOR_HISILICON is not set
# CONFIG_NET_VENDOR_HUAWEI is not set
# CONFIG_NET_VENDOR_INTEL is not set
# CONFIG_NET_VENDOR_MARVELL is not set
# CONFIG_NET_VENDOR_MELLANOX is not set
# CONFIG_NET_VENDOR_MICREL is not set
# CONFIG_NET_VENDOR_MICROCHIP is not set
# CONFIG_NET_VENDOR_MICROSEMI is not set
# CONFIG_NET_VENDOR_NI is not set
# CONFIG_NET_VENDOR_NATSEMI is not set
# CONFIG_NET_VENDOR_NETRONOME is not set
CONFIG_NUC980_ETH0=y
# CONFIG_NUC980_ETH1 is not set
# CONFIG_NET_VENDOR_PENSANDO is not set
# CONFIG_NET_VENDOR_QUALCOMM is not set
# CONFIG_NET_VENDOR_RENESAS is not set
# CONFIG_NET_VENDOR_ROCKER is not set
# CONFIG_NET_VENDOR_SAMSUNG is not set
# CONFIG_NET_VENDOR_SEEQ is not set
# CONFIG_NET_VENDOR_SOLARFLARE is not set
# CONFIG_NET_VENDOR_SMSC is not set
# CONFIG_NET_VENDOR_SOCIONEXT is not set
# CONFIG_NET_VENDOR_STMICRO is not set
# CONFIG_NET_VENDOR_SYNOPSYS is not set
# CONFIG_NET_VENDOR_VIA is not set
# CONFIG_NET_VENDOR_WIZNET is not set
# CONFIG_NET_VENDOR_XILINX is not set
# CONFIG_USB_NET_DRIVERS is not set
# CONFIG_WLAN is not set

# --- Input ---
CONFIG_INPUT_EVDEV=y
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_SERIO is not set

# --- Serial / Console ---
# CONFIG_LEGACY_PTYS is not set
CONFIG_SERIAL_NUC980=y
CONFIG_SERIAL_NUC980_CONSOLE=y
# CONFIG_NUC980_UART1 is not set
# CONFIG_NUC980_UART2 is not set
# CONFIG_NUC980_UART3 is not set
# CONFIG_NUC980_UART4 is not set
# CONFIG_NUC980_UART5 is not set
# CONFIG_NUC980_UART6 is not set
# CONFIG_NUC980_UART7 is not set
# CONFIG_NUC980_UART8 is not set
# CONFIG_NUC980_UART9 is not set
# CONFIG_HW_RANDOM is not set

# --- I2C ---
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_GPIO=y
# CONFIG_I2C_BUS_NUC980_P0 is not set
CONFIG_I2C_BUS_NUC980_P1=y
# CONFIG_I2C_BUS_NUC980_P2 is not set
CONFIG_I2C_BUS_NUC980_P3=y

# --- SPI ---
CONFIG_SPI=y
CONFIG_SPI_NUC980_QSPI=y
CONFIG_SPI_NUC980_SPI=y
CONFIG_SPI_SPIDEV=y
# CONFIG_PTP_1588_CLOCK is not set

# --- Pinctrl & GPIO ---
CONFIG_PINCTRL_SINGLE=y
CONFIG_PINCTRL_NUC980=y
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_NUC980=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y

# --- Watchdog ---
CONFIG_WATCHDOG=y
CONFIG_NUC980_WDT=y
CONFIG_NUC980_WWDT=y

# --- LEDs ---
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y

# --- USB (disabled for BMC) ---
# CONFIG_USB_SUPPORT is not set

# --- Sound (disabled) ---
# CONFIG_SOUND is not set

# --- Media (disabled) ---
# CONFIG_MEDIA_SUPPORT is not set

# --- Framebuffer (disabled) ---
# CONFIG_FB is not set

# --- HID (disabled) ---
# CONFIG_HID is not set

# --- MMC/SD (disabled) ---
# CONFIG_MMC is not set

# --- RTC ---
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_NUC980=y

# --- DMA ---
CONFIG_DMADEVICES=y
CONFIG_NUC980_DMA=y

# --- IIO / ADC (disabled) ---
# CONFIG_IIO is not set

# --- PWM (disabled) ---
# CONFIG_PWM is not set

# --- Filesystem ---
# CONFIG_DNOTIFY is not set
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_JFFS2_FS=y
CONFIG_UBIFS_FS=y
CONFIG_UBIFS_FS_ADVANCED_COMPR=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_AUTOFS_FS=y

# --- Systemd requirements ---
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_FHANDLE=y
CONFIG_DMIID=y

# --- Security ---
CONFIG_LSM="lockdown,yama,loadpin,safesetid,integrity,bpf"
CONFIG_INIT_STACK_NONE=y

# --- Crypto ---
CONFIG_CRYPTO_USER=y
CONFIG_CRYPTO_SEQIV=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_RNG=y
CONFIG_CRYPTO_USER_API_AEAD=y
CONFIG_CRYPTO_DEV_NUC980=y
CONFIG_CRC_CCITT=y

# --- Debug ---
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_PREEMPT=y
# CONFIG_FTRACE is not set
CONFIG_STRICT_DEVMEM=y
CONFIG_UNWINDER_FRAME_POINTER=y
